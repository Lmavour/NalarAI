# MongoDB credentials belong in .env.local or .env and must never be committed.
MONGODB_URI="mongodb://USERNAME:PASSWORD@HOST:PORT/"
MONGODB_DB_NAME="nalarai"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PEPPER="replace-with-at-least-32-random-characters"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Configure at least one provider. Leave an unused provider's API key empty.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Groq is the primary model pool; Gemini is used when Groq is unavailable or exhausted.
GROQ_API_KEY=""
GROQ_MODELS="openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b"
GROQ_DAILY_TOKEN_LIMIT="200000"

# Point to a browser already installed on the machine. Playwright downloads are disabled.
PLAYWRIGHT_CHROMIUM_PATH="C:\\Users\\lmavour\\AppData\\Local\\Chromium\\Application\\chrome.exe"
